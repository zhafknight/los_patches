Date: Mon, 27 Jul 2026 00:00:00 +0800
Subject: [PATCH] kernel: support BOARD_CUSTOM_KERNEL_MK

Imported from lineage-diff-20260727 for the GT-N7000 LineageOS 23.2 tree.

---
diff --git a/build/tasks/kernel.mk b/build/tasks/kernel.mk
index a40187ed..3d4eb3e3 100644
--- a/build/tasks/kernel.mk
+++ b/build/tasks/kernel.mk
@@ -518,8 +518,14 @@ endif # TARGET_KERNEL_PLATFORM_TARGET or FULL_KERNEL_BUILD
 
 ifeq ($(FULL_KERNEL_BUILD),true)
 
+ifdef BOARD_CUSTOM_KERNEL_MK
+include $(BOARD_CUSTOM_KERNEL_MK)
+endif
+
+ifndef BOARD_CUSTOM_KERNEL_MK
 $(KERNEL_OUT):
 	mkdir -p $(KERNEL_OUT)
+endif
 
 $(KERNEL_CONFIG): $(KERNEL_OUT) $(ALL_KERNEL_DEFCONFIG_SRCS)
 	@echo "Building Kernel Config"
